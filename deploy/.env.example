MEDIA_REDIS_URL=redis://redis:6379/0
MEDIA_S3_ENDPOINT=garage:3900
MEDIA_S3_PUBLIC_ENDPOINT=localhost:3900
MEDIA_S3_REGION=garage
MEDIA_S3_ACCESS_KEY=GKdevmedia00000001
MEDIA_S3_SECRET_KEY=dev-media-secret-key-for-local-compose-demo
MEDIA_S3_BUCKET=media
MEDIA_PROCESSOR_TOKEN=dev-processor-token
# 開発デモ（既定）: X-Dev-User-Sub でユーザー切替。P01 IdP 連携時は下記 OIDC を有効化し MEDIA_DEV_AUTH=false
MEDIA_DEV_AUTH=true
MEDIA_QUOTA_BYTES=104857600
MEDIA_MAX_UPLOAD_BYTES=20971520

# OIDC（P01 pf-identity と併用。web に OIDC_ISSUER + OIDC_CLIENT_ID を渡すとログイン必須）
# OIDC_ISSUER=http://localhost:8080
# OIDC_INTERNAL_BASE=http://host.docker.internal:8080
# OIDC_AUDIENCE=pf-media-web
# MEDIA_DEV_AUTH=false
# web 側:
# OIDC_CLIENT_ID=pf-media-web
# OIDC_REDIRECT_URI=http://localhost:3004/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3004/logged-out
